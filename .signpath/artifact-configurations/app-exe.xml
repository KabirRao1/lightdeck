<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "app-exe": signs the Lightdeck application executable.
  Input: the GitHub workflow artifact "unsigned-app" (a ZIP containing lightdeck.exe).
  lightdeck-engine.exe (the upstream Node.js runtime, already signed by the OpenJS Foundation) is NOT signed here.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="lightdeck.exe" product-name="Lightdeck">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
