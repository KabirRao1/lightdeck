{
  "name": "lightdeck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A lightweight Windows desktop widget for Matter lights and plugs",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "sidecar": "npm --prefix sidecar run build",
    "setup": "npm install && npm --prefix sidecar install && npm run sidecar",
    "tauri": "tauri",
    "app:dev": "npm run sidecar && tauri dev",
    "app:build": "npm run sidecar && tauri build",
    "virtual-light": "npm --prefix sidecar exec tsx dev/virtual-light.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
