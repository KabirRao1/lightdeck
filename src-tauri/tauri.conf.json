{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lightdeck",
  "version": "0.1.0",
  "identifier": "io.github.kabirrao1.lightdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lightdeck",
        "width": 340,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --renderer-process-limit=1 --disable-background-networking"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "KabirRao1",
    "shortDescription": "Desktop widget for Matter lights and plugs",
    "longDescription": "A lightweight desktop widget to control Matter smart lights and plugs locally over your network: power, brightness, colors and multi-device scenes.",
    "category": "Utility",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/lightdeck-engine"],
    "resources": {
      "sidecar/matter-sidecar.mjs": "sidecar/matter-sidecar.mjs",
      "sidecar/matter-sidecar.mjs.LEGAL.txt": "sidecar/THIRD-PARTY-LICENSES.txt"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
